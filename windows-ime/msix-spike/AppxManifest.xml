<?xml version="1.0" encoding="utf-8"?>
<!--
  ⚠ THROWAWAY SPIKE — delete with .github/workflows/windows-ime-msix-spike.yml.

  Identity/Publisher/PublisherDisplayName are the REAL Partner Center values
  (windows-ime/store-identity.md), so installing this package is a faithful
  rehearsal of the Store upload rather than an approximation. The self-signed
  certificate the workflow creates must carry exactly the Publisher subject
  below or Add-AppxPackage refuses the package.

  runFullTrust is the restricted capability that lets a Win32 desktop app —
  one that calls SetWindowsHookEx and SendInput — live inside MSIX at all.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="BangluTyper.BangluTyper"
    Publisher="CN=B71AC99C-C3DF-48A2-B8A6-957E15042785"
    Version="1.0.1.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Banglu Typer</DisplayName>
    <PublisherDisplayName>Banglu Typer</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="BangluTyper" Executable="BangluTyper.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Banglu Typer"
        Description="Type Bangla anywhere on Windows"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
